{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/superpowers-gate.sh",
            "timeout": 8,
            "statusMessage": "Checking superpowers gate..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_PATH}}\" \"{{CLAUDE_DIR}}/hooks/agent-model-verifier.js\"",
            "timeout": 5,
            "statusMessage": "Verifying agent model..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/destructive-bash-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking for destructive commands..."
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/worktree-cleanup-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking worktree cleanliness..."
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/todos-policy-injector.sh",
            "timeout": 8,
            "statusMessage": "Checking todos repo policy..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/worktree-task-bind.sh",
            "timeout": 5,
            "statusMessage": "Checking worktree task binding..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/worktree-mismatch-check.sh",
            "timeout": 5,
            "statusMessage": "Checking worktree match..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          { "type": "command", "command": "${HOME}/.claude/hooks/memory-precompact.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          { "type": "command", "command": "${HOME}/.claude/hooks/memory-precompact.sh", "timeout": 5 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/global-session-start.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/task-record-session.sh",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/global-session-start.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/task-record-session.sh",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/global-session-start.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/task-record-session.sh",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_PATH}}\" \"{{CLAUDE_DIR}}/hooks/caveman-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/memory-git-consolidate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/task-record-post.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/task-record-stop.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/memory-journal.sh",
            "timeout": 5,
            "statusMessage": "Checking memory journal..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/task-record-prompt.sh",
            "timeout": 5,
            "statusMessage": "Checking task record..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_PATH}}\" \"{{CLAUDE_DIR}}/hooks/caveman-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking caveman mode..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_PATH}}\" \"{{CLAUDE_DIR}}/hooks/context-guard.js\"",
            "timeout": 5,
            "statusMessage": "Checking context..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE_PATH}}\" \"{{CLAUDE_DIR}}/hooks/model-routing-reminder.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"{{CLAUDE_DIR}}/hooks/caveman-statusline.sh\""
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "caveman@caveman": true,
    "slack@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "stitch-skills@google-labs-code": true,
    "antigravity@marcosnahuel-antigravity": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "google-labs-code": {
      "source": {
        "source": "github",
        "repo": "google-labs-code/stitch-skills"
      }
    },
    "marcosnahuel-antigravity": {
      "source": {
        "source": "git",
        "url": "https://github.com/MarcosNahuel/antigravity-plugin-cc.git"
      }
    }
  },
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.167",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "effortLevel": "medium"
}

